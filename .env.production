# Production Environment Configuration
NODE_ENV=production

# Application URLs
NEXT_PUBLIC_APP_URL=https://zergoqr.vercel.app
NEXT_PUBLIC_API_URL=https://zergoqr.vercel.app/api

# Database Configuration (Neon production)
DATABASE_URL=postgresql://username:password@prod-host.neon.tech/zergoqr
DIRECT_URL=postgresql://username:password@prod-host.neon.tech/zergoqr

# Authentication (use strong production secrets)
JWT_SECRET=production-jwt-secret-key-replace-with-actual-strong-secret
NEXTAUTH_SECRET=production-nextauth-secret-key-32-chars-replace-with-actual
NEXTAUTH_URL=https://zergoqr.vercel.app

# Redis/KV Configuration (Vercel KV production)
KV_URL=redis://production-kv-url
KV_REST_API_URL=https://production-kv-rest-api-url
KV_REST_API_TOKEN=production-kv-token

# External Services - Production Configuration
TWILIO_ACCOUNT_SID=ACprod123456789abcdef
TWILIO_AUTH_TOKEN=production_auth_token_replace_with_actual
TWILIO_PHONE_NUMBER=+911234567890

# Payment Gateway - Production Configuration
RAZORPAY_KEY_ID=rzp_live_production_key_id
RAZORPAY_KEY_SECRET=production_secret_key_replace_with_actual

# Monitoring (enabled for production)
SENTRY_DSN=https://production-sentry-dsn@sentry.io/project
LOGTAIL_TOKEN=production-logtail-token-replace-with-actual

# Production Configuration
MOCK_EXTERNAL_SERVICES=false
ENABLE_DEBUG_LOGS=false
NEXT_TELEMETRY_DISABLED=1
