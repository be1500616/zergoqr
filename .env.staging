# Staging Environment Configuration
NODE_ENV=staging

# Application URLs (replace with actual staging URLs)
NEXT_PUBLIC_APP_URL=https://staging.zergoqr.vercel.app
NEXT_PUBLIC_API_URL=https://staging.zergoqr.vercel.app/api

# Database Configuration (Neon staging branch)
DATABASE_URL=postgresql://username:password@staging-host.neon.tech/zergoqr_staging
DIRECT_URL=postgresql://username:password@staging-host.neon.tech/zergoqr_staging

# Authentication (use staging-specific secrets)
JWT_SECRET=staging-jwt-secret-key-replace-with-actual
NEXTAUTH_SECRET=staging-nextauth-secret-key-32-chars-replace-with-actual
NEXTAUTH_URL=https://staging.zergoqr.vercel.app

# Redis/KV Configuration (Vercel KV staging)
KV_URL=redis://staging-kv-url
KV_REST_API_URL=https://staging-kv-rest-api-url
KV_REST_API_TOKEN=staging-kv-token

# External Services - Test/Sandbox Configuration
TWILIO_ACCOUNT_SID=ACstaging123456789abcdef
TWILIO_AUTH_TOKEN=staging_auth_token_replace_with_actual
TWILIO_PHONE_NUMBER=+911234567890

# Payment Gateway - Test Configuration
RAZORPAY_KEY_ID=rzp_test_staging_key_id
RAZORPAY_KEY_SECRET=staging_secret_key_replace_with_actual

# Monitoring (enabled for staging)
SENTRY_DSN=https://staging-sentry-dsn@sentry.io/project
LOGTAIL_TOKEN=staging-logtail-token-replace-with-actual

# Staging Configuration
MOCK_EXTERNAL_SERVICES=false
ENABLE_DEBUG_LOGS=true
NEXT_TELEMETRY_DISABLED=1
