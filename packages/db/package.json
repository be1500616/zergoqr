{
  "name": "@zergoqr/db",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/seed.ts",
    "db:seed:dev": "NODE_ENV=development tsx src/seed.ts",
    "db:reset": "prisma migrate reset --force && pnpm db:seed:dev"
  },
  "dependencies": {
    "@prisma/client": "^5.6.0",
    "@zergoqr/config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "prisma": "^5.6.0",
    "tsx": "^4.1.0",
    "typescript": "^5.2.0"
  }
}
