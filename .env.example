# Environment Configuration
NODE_ENV=development

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zergoqr
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/zergoqr

# Authentication
JWT_SECRET=dev-jwt-secret-key-minimum-16-chars
NEXTAUTH_SECRET=dev-nextauth-secret-key-32-chars-minimum
NEXTAUTH_URL=http://localhost:3000

# Redis/KV Configuration (for development with Docker)
KV_URL=redis://localhost:6379
KV_REST_API_URL=http://localhost:6379
KV_REST_API_TOKEN=dev-token

# External Services - Twilio (use test credentials or mocks)
TWILIO_ACCOUNT_SID=ACtest123456789abcdef
TWILIO_AUTH_TOKEN=test_auth_token_32_chars_minimum
TWILIO_PHONE_NUMBER=+911234567890

# Payment Gateway - Razorpay (use test credentials)
RAZORPAY_KEY_ID=rzp_test_1234567890
RAZORPAY_KEY_SECRET=test_secret_key_32_chars_minimum

# Monitoring (optional for development)
SENTRY_DSN=
LOGTAIL_TOKEN=

# Development Configuration
MOCK_EXTERNAL_SERVICES=true
ENABLE_DEBUG_LOGS=true

# File Upload
UPLOADTHING_SECRET=your-uploadthing-secret
UPLOADTHING_APP_ID=your-uploadthing-app-id
